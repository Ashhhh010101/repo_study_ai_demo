# Copy this file to .env for local development.
# Do not commit real .env files or provider API keys.

DATABASE_URL=sqlite:///./repo_study_ai.db
DATA_DIR=./data
REPOS_DIR=./data/repos
VECTOR_STORE_DIR=./data/vector_store
MAX_FILE_SIZE_BYTES=512000
MAX_SCANNED_FILES=5000
MAX_TOTAL_SCAN_BYTES=50000000
MAX_CHUNK_CHARS=4000
ANALYSIS_MAX_WORKERS=4
REQUEST_TIMEOUT_SECONDS=90
CLONE_TIMEOUT_SECONDS=180
MAX_REPO_CLONE_BYTES=200000000
RATE_LIMIT_WINDOW_SECONDS=60
ANALYZE_RATE_LIMIT=3
CHAT_RATE_LIMIT=20
VISIT_RATE_LIMIT=10
RATE_LIMIT_MAX_CLIENTS=10000
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
LLM_TEMPERATURE=0.1
SUMMARY_CACHE_ENTRIES=512
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]
# Production: set these to the public frontend and API hostnames.
# CORS_ORIGINS=["https://your-frontend.example.com"]
# ALLOWED_HOSTS=["your-api.example.com"]
